{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simonflitter-website",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "simonflitter.com", "custom_domain": true },
    { "pattern": "www.simonflitter.com", "custom_domain": true }
  ]
}
